<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.LibrosController"
      prefWidth="900" prefHeight="600">

    <Label text="Libros" style="-fx-font-size: 22px;"/>

    <GridPane hgap="10" vgap="10" maxWidth="600">
        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="ISBN:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIsbn" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Año:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAnio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Autor:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbAutor" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Activo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkActivo" GridPane.rowIndex="4" GridPane.columnIndex="1" selected="true"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Nuevo" onAction="#onNuevo"/>
        <Button text="Guardar" onAction="#onGuardar"/>
        <Button text="Modificar" onAction="#onModificar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Button text="Mostrar Tabla" onAction="#onToggleTabla"/>
        <Button text="Volver" onAction="#onVolver"/>
    </HBox>

    <ListView fx:id="listLibros" prefHeight="200" maxWidth="700"/>

    <TableView fx:id="tblLibros" prefHeight="300" maxWidth="700">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="200"/>
            <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="120"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="180"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="60"/>
        </columns>
    </TableView>

</VBox>
