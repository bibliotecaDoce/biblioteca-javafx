<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.MenuController"
      prefWidth="700" prefHeight="450">
    <Label text="Biblioteca" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <VBox spacing="10" maxWidth="240">
        <Button text="Autores" onAction="#onAutores" prefHeight="40"/>
        <Button text="Libros" onAction="#onLibros" prefHeight="40"/>
        <Button text="Salir" onAction="#onSalir" prefHeight="40"/>
    </VBox>
</VBox>
