<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.AutoresController"
      prefWidth="900" prefHeight="600">

    <Label text="Autores" style="-fx-font-size: 22px;"/>

    <GridPane hgap="10" vgap="10" maxWidth="600">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nacionalidad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNacionalidad" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>


    <HBox spacing="10">
        <Button text="Nuevo" onAction="#onNuevo"/>
        <Button text="Guardar" onAction="#onGuardar"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
        <Button fx:id="btnEliminar" text="Eliminar seleccionado" onAction="#onEliminar"/>
        <Button fx:id="btnToggleTabla" text="Ver tabla" onAction="#onToggleTabla"/>
        <Button text="Volver" onAction="#onVolver"/>
    </HBox>


    <Label text="Listado (ListView)" style="-fx-font-weight: bold;"/>

    <ListView fx:id="lstAutores" prefHeight="180" maxWidth="700"/>

    <Label text="Tabla (se muestra con el botón)" style="-fx-font-weight: bold;"/>

    <!-- IMPORTANTE: visible=false y managed=false para que no deje hueco cuando esté oculta -->
    <TableView fx:id="tblAutores" prefHeight="260" maxWidth="700" visible="false" managed="false">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="280"/>
            <TableColumn fx:id="colNacionalidad" text="Nacionalidad" prefWidth="220"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="80"/>
        </columns>
    </TableView>

</VBox>

